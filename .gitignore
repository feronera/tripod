.pod/
__pycache__/
*.pyc
# skill folder named build/ must be committed even when a global gitignore ignores build/
!plugins/superdev/skills/build/
!logs/
!logs/sample-app.log
# approvals must be committed even when a global gitignore ignores *.log
!docs/changes/*/gates.log
# the agent activity log is committed with the change too
!docs/changes/*/activity.log
!examples/**/gates.log
